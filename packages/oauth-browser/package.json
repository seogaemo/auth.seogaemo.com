{
	"name": "@seogaemo/oauth-browser",
	"version": "0.1.0",
	"description": "Browser (SPA) login for Seogaemo SSO: redirect, token storage, refresh across tabs. Built on @seogaemo/oauth.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@seogaemo/oauth": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22",
		"typescript": "^5",
		"vitest": "^3"
	},
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seogaemo/auth.seogaemo.com.git",
		"directory": "packages/oauth-browser"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"homepage": "https://github.com/seogaemo/auth.seogaemo.com/tree/main/packages/oauth-browser#readme",
	"keywords": [
		"oauth",
		"oauth2",
		"openid-connect",
		"oidc",
		"pkce",
		"seogaemo",
		"sso",
		"spa",
		"browser"
	]
}
