generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

/// Seogaemo SSO에 등록된 서비스 (OAuth 클라이언트).
/// 시스템 서비스(isSystem)는 Seogaemo 콘솔 자신이다.
model Service {
  id               String  @id @default(cuid())
  clientId         String  @unique
  /// SHA-256(client_secret) hex. 원문은 발급할 때 한 번만 보여준다.
  clientSecretHash String
  name             String
  /// R2 object key
  logoKey          String?
  /// string[]
  redirectUris     Json    @default("[]")
  /// string[]. 로그아웃 뒤 돌아갈 주소. post_logout_redirect_uri가 이 중 하나와 정확히 같아야 한다 (RP-Initiated Logout 3.1)
  postLogoutRedirectUris Json @default("[]")
  /// ID 토큰 서명 알고리즘 ("ES256" | "RS256"). 새 앱은 RS256 (OIDC 기본값), 0008 이전 앱은 ES256
  idTokenSigningAlg String @default("ES256")
  /// ("google" | "kakao")[]
  providers        Json    @default("[]")
  brandColor       String?
  brandBackground  String?
  isSystem         Boolean @default(false)

  /// 켜면 allowedEmails에 맞는 이메일만 로그인할 수 있다
  restrictLogin Boolean @default(false)
  /// string[]. 이메일(name@example.com) 또는 도메인(example.com). 소문자
  allowedEmails Json    @default("[]")

  /// 새 사용자 가입을 받을지. 끄면 기존 사용자만 로그인한다.
  signupEnabled Boolean @default(true)
  /// 로그인 화면 아래에 거는 이용약관, 개인정보 처리방침 주소
  termsUrl      String?
  privacyUrl    String?

  /// 서비스를 등록한 개발자. 개발자는 시스템 서비스(콘솔)의 User다.
  ownerId String?
  owner   User?   @relation("OwnedServices", fields: [ownerId], references: [id])

  users              User[]              @relation("ServiceUsers")
  identities         Identity[]
  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]
  loginTransactions  LoginTransaction[]
  emailCodes         EmailCode[]
  members            ServiceMember[]
  sessions           Session[]
  loginEvents        LoginEvent[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 서비스 관리자 (소유자 말고 콘솔에서 이 서비스를 같이 관리하는 개발자).
/// 콘솔 계정의 확인된 이메일로 맞춘다. 아직 콘솔에 가입하지 않은 사람도 미리 추가할 수 있다.
model ServiceMember {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// 소문자로 저장한다
  email       String
  invitedById String?

  createdAt DateTime @default(now())

  @@unique([serviceId, email])
  @@index([email])
}

/// 서비스별 사용자. 같은 사람이라도 서비스가 다르면 다른 User다.
model User {
  id     String  @id @default(cuid())
  email  String?
  name   String?
  image  String?

  serviceId String
  service   Service @relation("ServiceUsers", fields: [serviceId], references: [id], onDelete: Cascade)

  identities         Identity[]
  ownedServices      Service[]           @relation("OwnedServices")
  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]
  sessions           Session[]

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  /// 콘솔에서 정지한 시각. 정지되면 로그인, 토큰 갱신, userinfo가 막힌다.
  disabledAt  DateTime?

  @@unique([serviceId, email])
}

/// 사용자에 연결된 로그인 수단 (password, email, google, kakao, passkey).
/// password, email, passkey는 providerUserId가 소문자 이메일이다.
model Identity {
  id             String  @id @default(cuid())
  provider       String
  providerUserId String
  email          String?

  /// provider = password일 때만. PBKDF2 해시 (lib/password.ts 형식)
  passwordHash   String?
  /// 연속 로그인 실패 횟수와 잠금 시각 (비밀번호 무차별 대입 방지)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceId, provider, providerUserId])
  @@index([userId])
}

/// /oauth/authorize 부터 외부 제공자 콜백까지 이어지는 로그인 진행 상태.
model LoginTransaction {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// 서비스가 보낸 값
  redirectUri         String
  state               String?
  scope               String
  nonce               String?
  codeChallenge       String
  codeChallengeMethod String

  /// 외부 제공자로 보낼 때 채운다
  provider             String?
  providerState        String? @unique
  providerCodeVerifier String?

  /// OIDC prompt (공백 구분), max_age(초), login_hint
  prompt    String?
  maxAge    Int?
  loginHint String?
  /// 서비스로 code를 보내지 않고 우리 화면(/account)으로 돌아가는 로그인. 이때 PKCE 값은 빈 문자열이다.
  returnTo  String?

  /// 로그인은 확인됐지만 패스키 저장 제안(/login/passkey)을 거치느라 아직 code를 내주지 않은 사용자와 그 수단
  verifiedUserId String?
  verifiedMethod String?
  /// 진행 중인 WebAuthn 요청(등록, 로그인)의 challenge. 한 번 쓰면 지운다.
  webauthnChallenge String?

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthorizationCode {
  /// SHA-256(code) hex
  codeHash String @id

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  redirectUri         String
  scope               String
  nonce               String?
  codeChallenge       String
  codeChallengeMethod String
  /// 이 code를 만든 로그인 세션과 마지막으로 직접 인증한 시각 (id_token의 sid, auth_time)
  sessionId           String?
  authTime            DateTime?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RefreshToken {
  /// SHA-256(token) hex
  tokenHash String @id

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope     String
  /// 로그아웃하면 이 세션에서 나온 토큰을 같이 끊는다
  sessionId String?
  /// 이 토큰을 처음 받게 한 직접 인증 시각. 회전해도 이어진다 (갱신 ID 토큰의 auth_time, OIDC Core 12.2)
  authTime  DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
}

/// 브라우저의 로그인 상태 (서비스마다 하나). 쿠키 sg_browser 값의 해시로 찾는다.
/// 살아 있으면 /oauth/authorize가 로그인 화면 없이 바로 code를 준다.
model Session {
  id          String @id @default(cuid())
  /// SHA-256(sg_browser 쿠키) hex
  browserHash String

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 마지막으로 직접 인증한 시각과 수단 (password, email, google, kakao, passkey)
  authTime  DateTime
  method    String
  userAgent String?
  ip        String?

  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([browserHash, serviceId])
  @@index([userId])
}

/// 로그인, 가입, 실패 기록 (사용자 상세, 통계)
model LoginEvent {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// 실패면 없을 수 있다. 사용자를 지워도 기록은 통계용으로 남긴다.
  userId    String?
  email     String?

  /// login | signup | failure
  type      String
  /// password | email | google | kakao | passkey | session
  method    String?
  /// 실패 이유 (wrong_password, locked, wrong_code, disabled, rate_limited ...)
  reason    String?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([serviceId, createdAt])
  @@index([userId, createdAt])
}

/// 콘솔에서 누가 언제 무엇을 바꿨는지
model AuditLog {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  actorId    String?
  actorEmail String?
  /// settings.update, branding.update, secret.rotate, member.add, member.remove,
  /// user.delete, user.disable, user.enable, user.sessions.revoke, signup.update
  action     String
  /// 대상 (사용자 이메일, 관리자 이메일 등)
  target     String?

  createdAt DateTime @default(now())

  @@index([serviceId, createdAt])
}

/// 메일로 보내는 6자리 인증 코드 (회원가입, 이메일 코드 로그인, 비밀번호 재설정)
model EmailCode {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// 이 코드를 요청한 로그인 진행. 다른 브라우저에서는 쓸 수 없다.
  transactionId String

  /// signup | login | reset
  purpose   String
  /// 소문자
  email     String
  /// SHA-256(code) hex
  codeHash  String
  /// 회원가입일 때 미리 받아 둔 비밀번호 해시
  pendingPasswordHash String?

  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([serviceId, email, createdAt])
}

/// 패스키 소유자. 서비스가 아니라 이메일 하나에 붙는다 (RP는 auth.seogaemo.com 하나).
/// id가 WebAuthn user.id(userHandle)다. 이메일을 쓰는 사용자가 어느 서비스에도 없으면 청소로 지운다.
model PasskeyOwner {
  /// 랜덤 userHandle (base64url)
  id    String @id
  /// 소문자
  email String @unique

  passkeys Passkey[]

  createdAt DateTime @default(now())
}

model Passkey {
  /// credentialId (base64url)
  id String @id

  ownerId String
  owner   PasskeyOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// COSE 공개키 (base64url)
  publicKey  String
  counter    Int     @default(0)
  /// JSON string[] (internal, hybrid, ...)
  transports String?
  aaguid     String?
  /// singleDevice | multiDevice
  deviceType String
  backedUp   Boolean @default(false)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([ownerId])
}
