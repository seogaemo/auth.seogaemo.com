{
	"name": "@seogaemo/oauth-browser",
	"version": "0.0.0",
	"private": true,
	"description": "Browser (SPA) login for Seogaemo SSO: redirect, token storage, refresh. Built on @seogaemo/oauth.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@seogaemo/oauth": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5"
	}
}
