/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-seogaemo-com",
	"main": "worker.ts",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 매일 03:17 (KST) 만료된 행 청소. worker.ts의 scheduled
	"triggers": { "crons": ["17 18 * * *"] },
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
    {
      "pattern": "auth.seogaemo.com",
      "custom_domain": true
    }
  ],
	"d1_databases": [
    {
      "binding": "DB",
      "database_name": "db.auth.seogaemo.com",
      "database_id": "170e7f8e-2caa-416e-a969-ff22e7ccc3a9"
    }
  ],
	// IP별 로그인 시도 제한 (lib/rate-limit.ts). namespace_id는 계정 안에서 이 제한을 구분하는 아무 숫자다.
	"ratelimits": [
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "r2-auth-seogaemo-com"
    }
  ],
	/**
	 * Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/placement/
	 */
	// 한국 요청이 LAX 같은 먼 곳으로 들어온다. Smart Placement는 분석을 끝내고도 그 자리(local-LAX)에서 돌려서
	// 요청마다 D1까지 태평양을 여러 번 오갔다. D1 primary가 싱가포르(SIN)라 Worker를 그 옆에 고정한다.
	// DB를 옮기면 이 값도 같이 바꾼다 (wrangler d1 execute DB --remote --json 의 meta.served_by_colo).
	"placement": { "region": "aws:ap-southeast-1" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	"vars": {
		"ISSUER": "https://auth.seogaemo.com",
		"GOOGLE_CLIENT_ID": "247451597886-t3595mbr1n6rk137sncl3hjf5hqbh43i.apps.googleusercontent.com",
		"KAKAO_CLIENT_ID": "17ed27df4cc38c84fff31b8fde04cb86",
		"SMTP_HOST": "mail.smtp2go.com",
		"SMTP_PORT": "2525",
		"SMTP_USERNAME": "seogaemo",
		"MAIL_FROM": "Seogaemo <no-reply@seogaemo.com>",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAGEy0Ln2elAhK46_"
	},
	// 비밀값은 여기 두지 않는다. 로컬은 .dev.vars, 배포 환경은 `wrangler secret put <NAME>`.
	// 필요한 시크릿: JWT_PRIVATE_JWK, JWT_RSA_PRIVATE_JWK, GOOGLE_CLIENT_SECRET, SMTP_PASSWORD, (선택) KAKAO_CLIENT_SECRET, TURNSTILE_SECRET_KEY, (선택) GRAVATAR_API_KEY
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
