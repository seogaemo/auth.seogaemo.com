{
	"name": "auth-seogaemo-com",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"postinstall": "prisma generate",
		"db:migrate:local": "wrangler d1 migrations apply db.auth.seogaemo.com --local",
		"db:migrate:remote": "wrangler d1 migrations apply db.auth.seogaemo.com --remote",
		"db:diff": "node scripts/db-diff.mjs",
		"db:seed:local": "node scripts/seed-dev.mjs",
		"check:providers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-providers.mts"
	},
	"packageManager": "pnpm@9.15.9",
	"dependencies": {
		"@prisma/adapter-d1": "^6.7.0",
		"@prisma/client": "^6.7.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.1.0",
		"dotenv": "^16.5.0",
		"jose": "^6",
		"next": "15.5.28",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261101.1",
		"@eslint/eslintrc": "^3",
		"@opennextjs/cloudflare": "^1.20.15",
		"@seogaemo/ds-tailwind": "^1.0.16",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9.39.5",
		"eslint-config-next": "15.5.28",
		"playwright-core": "^1.65.1",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"prisma": "^6.7.0",
		"tailwind-scrollbar-hide": "^2.0.0",
		"tailwindcss": "^3.4.1",
		"typescript": "^5",
		"wrangler": "^4.156.1"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion@1": "^1.1.21",
			"brace-expansion@2": "^2.1.7",
			"flatted": "^3.4.2",
			"glob@10": "^10.5.0",
			"js-yaml@4": "^4.3.2",
			"minimatch@3": "^3.1.4",
			"minimatch@9": "^9.0.7",
			"nanoid@3": "^3.3.18",
			"path-to-regexp@8": "^8.4.0",
			"picomatch@2": "^2.3.2",
			"picomatch@4": "^4.0.4",
			"postcss": "^8.5.23",
			"source-map-js": "^1.2.2",
			"@humanfs/node": "^0.16.8",
			"ajv@6": "^6.14.0",
			"postcss-selector-parser@6": "^6.1.5",
			"yaml@2": "^2.8.3"
		}
	}
}
