{
	"name": "@seogaemo/oauth-next",
	"version": "0.1.0",
	"description": "Next.js (App Router) login for Seogaemo SSO: route handlers, encrypted session cookie, token refresh. Built on @seogaemo/oauth.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@seogaemo/oauth": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22",
		"next": "15.5.29",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"next": ">=14"
	},
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seogaemo/auth.seogaemo.com.git",
		"directory": "packages/oauth-next"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"homepage": "https://github.com/seogaemo/auth.seogaemo.com/tree/main/packages/oauth-next#readme",
	"keywords": [
		"oauth",
		"oauth2",
		"openid-connect",
		"oidc",
		"pkce",
		"seogaemo",
		"sso",
		"nextjs"
	]
}
