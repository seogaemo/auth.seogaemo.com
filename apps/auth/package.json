{
	"name": "@seogaemo/auth",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"postinstall": "prisma generate",
		"db:migrate:local": "wrangler d1 migrations apply db.auth.seogaemo.com --local",
		"db:migrate:remote": "wrangler d1 migrations apply db.auth.seogaemo.com --remote",
		"db:diff": "node scripts/db-diff.mjs",
		"db:seed:local": "node scripts/seed-dev.mjs",
		"check:providers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-providers.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@prisma/adapter-d1": "^6.7.0",
		"@prisma/client": "^6.7.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.1.0",
		"dotenv": "^16.5.0",
		"jose": "^6",
		"next": "15.5.28",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261101.1",
		"@eslint/eslintrc": "^3",
		"@opennextjs/cloudflare": "^1.20.15",
		"@seogaemo/ds-tailwind": "^1.0.16",
		"@seogaemo/oauth": "workspace:*",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9.39.5",
		"eslint-config-next": "15.5.28",
		"playwright-core": "^1.65.1",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"prisma": "^6.7.0",
		"tailwind-scrollbar-hide": "^2.0.0",
		"tailwindcss": "^3.4.1",
		"typescript": "^5",
		"wrangler": "^4.156.1"
	}
}
