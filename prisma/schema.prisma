generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

/// Seogaemo SSO에 등록된 서비스 (OAuth 클라이언트).
/// 시스템 서비스(isSystem)는 Seogaemo 콘솔 자신이다.
model Service {
  id               String  @id @default(cuid())
  clientId         String  @unique
  /// SHA-256(client_secret) hex. 원문은 발급할 때 한 번만 보여준다.
  clientSecretHash String
  name             String
  /// R2 object key
  logoKey          String?
  /// string[]
  redirectUris     Json    @default("[]")
  /// ("google" | "kakao")[]
  providers        Json    @default("[]")
  brandColor       String?
  brandBackground  String?
  isSystem         Boolean @default(false)

  /// 서비스를 등록한 개발자. 개발자는 시스템 서비스(콘솔)의 User다.
  ownerId String?
  owner   User?   @relation("OwnedServices", fields: [ownerId], references: [id])

  users              User[]              @relation("ServiceUsers")
  identities         Identity[]
  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]
  loginTransactions  LoginTransaction[]
  emailCodes         EmailCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 서비스별 사용자. 같은 사람이라도 서비스가 다르면 다른 User다.
model User {
  id     String  @id @default(cuid())
  email  String?
  name   String?
  image  String?

  serviceId String
  service   Service @relation("ServiceUsers", fields: [serviceId], references: [id], onDelete: Cascade)

  identities         Identity[]
  ownedServices      Service[]           @relation("OwnedServices")
  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([serviceId, email])
}

/// 사용자에 연결된 로그인 수단 (password, email, google, kakao).
/// password, email은 providerUserId가 소문자 이메일이다.
model Identity {
  id             String  @id @default(cuid())
  provider       String
  providerUserId String
  email          String?

  /// provider = password일 때만. PBKDF2 해시 (lib/password.ts 형식)
  passwordHash   String?
  /// 연속 로그인 실패 횟수와 잠금 시각 (비밀번호 무차별 대입 방지)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceId, provider, providerUserId])
  @@index([userId])
}

/// /oauth/authorize 부터 외부 제공자 콜백까지 이어지는 로그인 진행 상태.
model LoginTransaction {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// 서비스가 보낸 값
  redirectUri         String
  state               String?
  scope               String
  nonce               String?
  codeChallenge       String
  codeChallengeMethod String

  /// 외부 제공자로 보낼 때 채운다
  provider             String?
  providerState        String? @unique
  providerCodeVerifier String?

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthorizationCode {
  /// SHA-256(code) hex
  codeHash String @id

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  redirectUri         String
  scope               String
  nonce               String?
  codeChallenge       String
  codeChallengeMethod String

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RefreshToken {
  /// SHA-256(token) hex
  tokenHash String @id

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// 메일로 보내는 6자리 인증 코드 (회원가입, 이메일 코드 로그인, 비밀번호 재설정)
model EmailCode {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// 이 코드를 요청한 로그인 진행. 다른 브라우저에서는 쓸 수 없다.
  transactionId String

  /// signup | login | reset
  purpose   String
  /// 소문자
  email     String
  /// SHA-256(code) hex
  codeHash  String
  /// 회원가입일 때 미리 받아 둔 비밀번호 해시
  pendingPasswordHash String?

  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([serviceId, email, createdAt])
}
