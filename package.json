			"js-yaml@4": "^4.3.2",
			"minimatch@3": "^3.1.4",
			"nanoid@3": "^3.3.18",
			"path-to-regexp@8": "^8.4.0",
			"picomatch@2": "^2.3.2",
			"picomatch@4": "^4.0.4",
			"postcss": "^8.5.23",
			"source-map-js": "^1.2.2",
			"@humanfs/node": "^0.16.8",
			"ajv@6": "^6.14.0",
			"postcss-selector-parser@6": "^6.1.5",
			"yaml@2": "^2.8.3",
			"glob@10": "^14.0.2",
			"glob@13": "^14.0.2",
			"minimatch@9": "^11.0.1",
			"minimatch@10": "^11.0.1"
		}
	}
